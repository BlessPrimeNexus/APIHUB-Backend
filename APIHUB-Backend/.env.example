# Copy to .env and fill in. NEVER commit .env.
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
# Path of the SQLite database file (mount a persistent volume on it)
DATABASE_PATH=./data/apihub.db
# REQUIRED in production: 32+ random chars. Generate: openssl rand -hex 32
MASTER_KEY=
# Set to 1 when behind a TLS reverse proxy (Caddy/Nginx) that sets X-Forwarded-Proto
TRUST_PROXY=1
# Refuse non-HTTPS requests in production (checked via X-Forwarded-Proto)
REQUIRE_HTTPS=1
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=30
# Allow open registration (0 = invite only)
ALLOW_REGISTRATION=1
# Max request body (bytes)
MAX_BODY_BYTES=1048576
# Health-check scheduler interval (seconds), 0 disables
MONITOR_INTERVAL_SEC=60
# Allow health checks / outbound calls to private addresses (NEVER in production)
ALLOW_PRIVATE_TARGETS=0
# Max registrations per IP per hour
REGISTER_LIMIT_PER_HOUR=10
